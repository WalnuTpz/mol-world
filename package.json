{
  "name": "mol_world",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test --test-concurrency=1 tests/*.test.mts",
    "typecheck": "next typegen && tsc --noEmit",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:import": "tsx scripts/seed.ts",
    "data:ids": "tsx scripts/backfill-numid.ts",
    "data:title-tags": "tsx scripts/backfill-title-tags.ts",
    "data:daily-pool": "tsx scripts/rebuild-daily-pool.ts",
    "media:thumbnails": "tsx scripts/backfill-thumbs.ts",
    "media:rename": "tsx scripts/rename-media-by-numid.ts",
    "media:clean-trash": "tsx scripts/cleanup-trash.ts",
    "test:production": "tsx --test --test-concurrency=1 tests/production/*.test.mts"
  },
  "dependencies": {
    "@next/env": "16.4.2",
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "chart.js": "^4.6.1",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": "24.x",
    "pnpm": "10.x"
  }
}
