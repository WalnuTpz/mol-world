generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum MemeType {
  STATIC
  ANIMATED
}

enum MemeStatus {
  PENDING
  PUBLISHED
  HIDDEN
}

model Meme {
  id         String     @id @default(cuid())
  numId      Int?       @unique
  title      String?
  type       MemeType
  mediaUrl   String
  thumbUrl   String
  nameOrder  Float      @default(0)
  heat       Int        @default(0)
  copies     Int        @default(0)
  downloads  Int        @default(0)
  isFeatured Boolean    @default(false)
  status     MemeStatus @default(PUBLISHED)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  tags       MemeTag[]
  dailyPools DailyPoolItem[]

  @@index([status, createdAt, id])
  @@index([nameOrder, id])
  @@index([status, nameOrder, id])
  @@index([status, heat, createdAt, id])
  @@index([mediaUrl])
  @@index([thumbUrl])
}

model Tag {
  id    String    @id @default(cuid())
  numId Int?      @unique
  name  String    @unique
  memes MemeTag[]
}

model MemeTag {
  memeId String
  tagId  String
  meme   Meme @relation(fields: [memeId], references: [id])
  tag    Tag  @relation(fields: [tagId], references: [id])

  @@id([memeId, tagId])
  @@index([tagId])
}

model MemeDailyStat {
  day       String
  memeId    String
  copies    Int    @default(0)
  downloads Int    @default(0)

  @@id([day, memeId])
  @@index([day])
  @@index([memeId])
}

model SiteDailyStat {
  day       String   @id
  visits    Int      @default(0)
  visitors  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DailyPool {
  id         String          @id @default(cuid())
  day        String
  groupIndex Int
  items      DailyPoolItem[]

  @@unique([day, groupIndex])
}

model DailyPoolItem {
  id     String    @id @default(cuid())
  poolId String
  memeId String

  pool DailyPool @relation(fields: [poolId], references: [id], onDelete: Cascade)
  meme Meme      @relation(fields: [memeId], references: [id], onDelete: Cascade)

  @@unique([poolId, memeId])
  @@index([memeId])
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  status     String
  targetType String?
  targetId   String?
  message    String?
  data       Json?
  actorIp    String?
  actorUa    String?
  createdAt  DateTime @default(now())

  @@index([action])
  @@index([status])
  @@index([createdAt])
}

model AppConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model AdminCredential {
  id        String   @id @default(cuid())
  user      String   @unique
  passHash  String
  salt      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminSession {
  tokenHash      String   @id
  user           String
  credentialHash String
  expiresAt      DateTime

  @@index([expiresAt])
}

model MediaOperation {
  id        String   @id
  state     String
  created   Json
  retired   Json
  createdAt DateTime @default(now())
}

model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

model VisitorSession {
  tokenHash String   @id
  expiresAt DateTime
  @@index([expiresAt])
}

model SiteDailyVisitor {
  day         String
  visitorHash String
  @@id([day, visitorHash])
}

model InteractionGrant {
  tokenHash   String   @id
  visitorHash String
  memeId      String
  kind        String
  expiresAt   DateTime
  consumedAt  DateTime?
  @@index([expiresAt])
}
